import type { ActorSheetProps } from '@sheet-delver/sdk/react';
import { useSDK } from '@sheet-delver/sdk/react';

export default function Sheet({ actor, isOwner }: ActorSheetProps) {
    // assetUrl() resolves module-owned assets identically in dev and packaged builds.
    const { assetUrl, resolveImageUrl } = useSDK();
    const portrait = actor.img ? resolveImageUrl(actor.img) : assetUrl('icon.svg');

    // Styling is your choice (ADR-0027 section M):
    //   • Tailwind utility classes (below) — compiled at package time from src/styles/tailwind.css.
    //   • Hand-authored CSS (the `sheet-*` classes) — in assets/styles.css.
    // Both compose under the host's `.sdk-module--<module-id>` scope root; mix freely.
    return (
        <section className="sheet-root flex items-center gap-4">
            <img className="sheet-portrait" src={portrait} alt="" />
            <div className="flex flex-col">
                <p className="sheet-type text-xs uppercase tracking-wide opacity-70">{actor.type}</p>
                <h1 className="text-2xl font-bold">{actor.name}</h1>
                <p className="sheet-access">{isOwner ? 'Owner' : 'Observer'}</p>
            </div>
        </section>
    );
}
