/* Module styles must stay beneath the host-generated scope root. */
.sdk-module--%SYSTEM_ID% .sheet-root {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
}

.sdk-module--%SYSTEM_ID% .sheet-portrait {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: 4px;
}

.sdk-module--%SYSTEM_ID% .sheet-type,
.sdk-module--%SYSTEM_ID% .sheet-access {
    margin: 0;
    color: #6b7280;
}
